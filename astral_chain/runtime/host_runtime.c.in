   if(payload!=request.send_size-24 || !(packet[16]&4)) boundary("log-packet-layout",c,pc);
   if(sessions[session].destination) {
    char path[1024];
    if(!snapshot_path || snprintf(path,sizeof(path),"%s.logs",snapshot_path)>=(int)sizeof(path)) boundary("log-path",c,pc);
    if(log_bytes+request.send_size>16*1024*1024) boundary("log-budget",c,pc);
    FILE *log=fopen(path,"ab"); uint32_t length=(uint32_t)request.send_size;
    if(!log || fwrite(&length,4,1,log)!=1 || fwrite(packet,1,length,log)!=length || fclose(log)) boundary("log-write",c,pc);
    log_bytes+=length;
   }
   printf("LOG captured %llu bytes\n",(unsigned long long)request.send_size);
   reply_result(buffer,&request,0); c->x[0]=0; return;
  }
  if(kind==SESSION_LOGGER && request.command==1 && request.argument_size>=4) {
   unsigned destination=ipc_u32(request.arguments);
   if(destination&~3u) boundary("log-destination",c,pc);
