  if(debt>=1.0f) {float extra=floorf(debt);if(extra>7.0f) extra=7.0f;step+=extra;debt-=extra;}
  if(debt<-2.0f) debt=-2.0f;
  memcpy(&bits,&step,4);c->v[8]=bits;
  uint32_t ticks=(uint32_t)step;memcpy((void*)(uintptr_t)(c->x[19]+0xD8),&ticks,4);
