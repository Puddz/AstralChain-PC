  }
  if(kind==SESSION_SELF_CONTROLLER && request.command==16 && request.argument_size>=1) {
   if(request.arguments[0]>1) boundary("invalid-suspension-flag",c,pc);
   app_suspend_out_of_focus=request.arguments[0];reply_result(buffer,&request,0);c->x[0]=0;return;
  }
  if(kind==SESSION_SELF_CONTROLLER && request.command==14 && request.argument_size>=1) {
   if(request.arguments[0]>1) boundary("invalid-resume-notification-flag",c,pc);
   app_resume_notifications=request.arguments[0];reply_result(buffer,&request,0);c->x[0]=0;return;
  }
  if(kind==SESSION_SELF_CONTROLLER && (request.command==11 || request.command==12) && request.argument_size>=1) {
   if(request.arguments[0]>1) boundary("invalid-mode-notification-flag",c,pc);
   if(request.command==11) app_operation_notifications=request.arguments[0];
   else app_performance_notifications=request.arguments[0];
   reply_result(buffer,&request,0);c->x[0]=0;return;
  }
  if(kind==SESSION_COMMON_STATE && request.command==0) {
   uint32_t handle=copy_event(&app_message_event);app_open();
   ipc_reply_copy(buffer,256,handle,request.domain,request.token);c->x[0]=0;return;
  }
  if(kind==SESSION_COMMON_STATE && request.command==1) {
   unsigned message;
   if(app_receive(&message)) reply_value(buffer,&request,message);
   else reply_result(buffer,&request,0x680);
   c->x[0]=0;return;
  }
  if(kind==SESSION_COMMON_STATE && request.command==9) {
   reply_value(buffer,&request,app_focus);c->x[0]=0;return;
  }
  if(kind==SESSION_COMMON_STATE && (request.command==5 || request.command==6)) {
   reply_value(buffer,&request,request.command==5 ? app_operation_mode : app_performance_mode);c->x[0]=0;return;
  }
  if(kind==SESSION_LM && request.command==0 && request.send_pid) {
   reply_object(session,buffer,&request,SESSION_LOGGER); c->x[0]=0; return;
  }
  if(kind==SESSION_LOGGER && request.command==0) {
   Region data=query(request.send_address);
   if(!(data.permission&1) || request.send_size<24 || request.send_size>1024*1024 || request.send_size>data.size-(request.send_address-data.base))
    boundary("log-buffer-extent",c,pc);
   const uint8_t *packet=input;
