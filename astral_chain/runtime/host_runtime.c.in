/* Per-call log lines (SVC, IPC, audio and HID traffic): ~300 MB an hour of play. Off in lean (play) builds unless
 * AC_TRACE_CALLS is set; AC_QUIET=1 turns them off in the others. */
#ifndef LEAN_PAGES
#define LEAN_PAGES 0
#endif
static int hot_log_on(void) {
 static int on=-1;
 if(on<0) on=GetEnvironmentVariableA("AC_TRACE_CALLS",NULL,0)!=0 ||
  (!LEAN_PAGES && GetEnvironmentVariableA("AC_QUIET",NULL,0)==0);
 return on;
}
#define HOT_LOG(...) do{if(hot_log_on())printf(__VA_ARGS__);}while(0)
#ifndef CALL_LIMIT
#define CALL_LIMIT 1000000
#endif
#ifndef SYSCALL_LIMIT
#define SYSCALL_LIMIT 100000u
#endif
#ifndef APPLICATION_LANGUAGE
#define APPLICATION_LANGUAGE 0ull
#endif
#ifndef SYSTEM_LANGUAGE
#define SYSTEM_LANGUAGE 0ull
#endif
static __thread unsigned calls;  /* per host thread: shared counters bounced between cores in parallel mode */
static unsigned syscalls;
static __thread struct { uint64_t from,target; } recent_calls[64];
/* `state` is the calling host thread's guest context. Serialized mode (default): one host thread, contexts are
 * swapped into it by the scheduler. Parallel mode (AC_PARALLEL=1): every guest thread runs on its own host thread
 * in that thread's `state`; live_cpu[i] points at guest thread i's. Host services run under the kernel lock
 * (klock), guest code runs unlocked. */
static __thread Cpu state;
static Cpu *live_cpu[33];
static int parallel_mode;
static SRWLOCK klock_srw=SRWLOCK_INIT;
static volatile DWORD klock_owner;
static unsigned klock_depth;
static uint64_t klock_contended,klock_contended_qpc;  /* (updated under the lock) */
static uint64_t nvn_contended,nvn_contended_qpc;  /* (nvn_hle.h nvn_lock; parallel stats) */
static uint64_t nvn_thread_qpc[33],nvn_thread_calls[33];  /* host time in NVN calls per guest thread (parallel stats) */
static void klock(void) {
 if(!parallel_mode) return;
 DWORD me=GetCurrentThreadId();
 if(klock_owner==me) {klock_depth++;return;}
 if(!TryAcquireSRWLockExclusive(&klock_srw)) {  /* contended: count the time (parallel stats) */
  LARGE_INTEGER a,b;QueryPerformanceCounter(&a);
  AcquireSRWLockExclusive(&klock_srw);
  QueryPerformanceCounter(&b);klock_contended_qpc+=(uint64_t)(b.QuadPart-a.QuadPart);klock_contended++;
 }
 klock_owner=me;klock_depth=1;
}
static void kunlock(void) {
 if(!parallel_mode) return;
 if(--klock_depth==0) {klock_owner=0;ReleaseSRWLockExclusive(&klock_srw);}
}
/* Per guest thread: signaled when another thread makes it runnable (parallel_wake). A broadcast to every waiter
 * after each call woke ~15 sleeping threads thousands of times a frame (95k lock contentions per 2 s, run 421). */
static CONDITION_VARIABLE thread_cv[33];
/* Wait on the calling guest thread's condition with the lock fully released. */
static void klock_wait(unsigned self,DWORD ms) {
 unsigned depth=klock_depth;klock_owner=0;klock_depth=0;
 SleepConditionVariableSRW(&thread_cv[self],&klock_srw,ms,0);
 klock_owner=GetCurrentThreadId();klock_depth=depth;
}
static void parallel_wake(unsigned i) {if(parallel_mode && i<33) WakeConditionVariable(&thread_cv[i]);}
/* Run host code that blocks (sleeps, GPU waits) without holding the lock. */
static unsigned klock_release_all(void) {
 if(!parallel_mode || klock_owner!=GetCurrentThreadId()) return 0;
 unsigned depth=klock_depth;klock_owner=0;klock_depth=0;ReleaseSRWLockExclusive(&klock_srw);return depth;
}
static void klock_reacquire(unsigned depth) {
 if(!depth) return;
 AcquireSRWLockExclusive(&klock_srw);klock_owner=GetCurrentThreadId();klock_depth=depth;
}
static uint32_t application_terminate_result;
static int application_terminate_result_set;
static const char *snapshot_path;
static uint64_t entropy[4];
static uint64_t heap_base=0x7200000000ull;
/* Set once the heap is imported for Vulkan: its pages must stay CPU read-write. */
static int heap_gpu_pinned;
#define HEAP_BASE heap_base
#define HEAP_LIMIT 0x100000000ull
#define MEMORY_BUDGET (3ull*1024*1024*1024)
static uint64_t heap_size;
static int heap_reserved;
