 SESSION_HWOPUS, SESSION_AUDREN_MANAGER, SESSION_AUDIO_DEVICE, SESSION_AUDOUT_MANAGER, SESSION_AUDIO_OUTPUT, SESSION_NIFM_ROOT, SESSION_NIFM_GENERAL, SESSION_ACCOUNT, SESSION_ACCOUNT_MANAGER, SESSION_SAVE_FILESYSTEM, SESSION_SAVE_FILE, SESSION_PREPO };
