 PctlState policy,object_policy[32]; unsigned storage,object_storage[32];
 uint64_t vibration[2],object_vibration[32][2]; unsigned nv_transfer; uint64_t nv_aruid,nv_margin_requested;
 unsigned vi_policy,object_vi_policy[32],vi_level,object_vi_level[32],vi_displays,object_vi_displays[32];
