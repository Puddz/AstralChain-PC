   reply_result(buffer,&request,0); c->x[0]=0; return;
  }
  printf("UNIMPLEMENTED session=%u kind=%d command=%u args=%u copies=%u\n",session,(int)kind,request.command,(unsigned)request.argument_size,(unsigned)request.copy_count);
  boundary("unimplemented-service-command",c,pc);
 }
 if(imm==3) {
  uint64_t address=c->x[0],size=c->x[1];unsigned mask=(uint32_t)c->x[2],value=(uint32_t)c->x[3];
  if(address&4095) {c->x[0]=0xcc01;return;}
  if(!size || size&4095) {c->x[0]=0xca01;return;}
  if(mask&~8u || value&~mask) boundary("memory-attribute-mask",c,pc);
  if(address<HEAP_BASE || address>=HEAP_BASE+heap_size || size>HEAP_BASE+heap_size-address) {c->x[0]=0xd401;return;}
  uint64_t end=address+size;
  for(uint64_t at=address;at<end;) {
   Region r=query(at);
   if(r.kind!=5 || r.permission!=3) {c->x[0]=0xd401;return;}
   at=r.base+r.size;
  }
  c->x[0]=mask ? update_uncached(address,end,value!=0) : 0;return;
 }
 if(imm==6) {
  Region destination=query(c->x[0]);
  if(!(destination.permission&2) || c->x[0]-destination.base>destination.size || destination.size-(c->x[0]-destination.base)<40)
   boundary("query-output-outside-writable-memory",c,pc);
  Region result=query(c->x[2]);
  uint64_t info[5]={result.base,result.size,result.kind,result.permission,0};
  info[2]|=(uint64_t)memory_attribute(c->x[2])<<32;
  for(unsigned i=0;i<64;i++) if(stack_maps[i].size && c->x[2]>=stack_maps[i].source && c->x[2]-stack_maps[i].source<stack_maps[i].size)
   info[2]|=1ull<<32; /* MemoryAttribute::IsBorrowed */
  for(unsigned i=0;i<32;i++) if(transfer_memory[i].size && c->x[2]>=transfer_memory[i].address && c->x[2]-transfer_memory[i].address<transfer_memory[i].size)
   info[2]|=1ull<<32;
  memcpy((void*)(uintptr_t)c->x[0],info,40);
  c->x[0]=0; c->x[1]=0; return;
 }
 if(imm==0x29 && c->x[1]==11 && c->x[2]==0 && c->x[3]<4) {
  c->x[1]=entropy[c->x[3]]; c->x[0]=0; return;
 }
 if(thread_svc(c,imm)) return;
 if(imm==0x29 && c->x[2]==0xffff8001 && c->x[3]==0) {
  uint64_t result;
  switch(c->x[1]) {
   case 0: result=PROCESS_CORE_MASK; break;
   case 1: result=PROCESS_PRIORITY_MASK; break;
   case 2: result=0x4000000000ull; break;
   case 3: result=0x1000000000ull; break;
   case 4: result=HEAP_BASE; break;
   case 5: result=HEAP_LIMIT; break;
   case 6: case 21: result=MEMORY_BUDGET; break; /* Harness guest-memory budget. */
   case 7: case 22:
    result=static_memory_size()+heap_size;
    break;
   case 12: result=0; break;
   case 13: result=1ull<<39; break;
   case 14: result=STACK_BASE; break;
