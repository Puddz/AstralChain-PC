 SESSION_LIBRARY_CREATOR, SESSION_APPLICATION_FUNCTIONS, SESSION_DEBUG_FUNCTIONS, SESSION_AOC,
 SESSION_PCTL_ROOT, SESSION_PCTL, SESSION_TIME_ROOT, SESSION_TIME_USER,
 SESSION_TIME_NETWORK, SESSION_TIME_STEADY, SESSION_TIME_ZONE, SESSION_TIME_LOCAL, SESSION_APM_SESSION, SESSION_SETTINGS,
