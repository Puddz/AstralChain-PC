static void nvn_dump_recent(void);
static void stop_dump(Cpu *c);
static LONG CALLBACK fatal_fault_handler(PEXCEPTION_POINTERS info) {
 fflush(stdout);
 nvn_dump_recent();
 /* Host location: module + offset, and the faulting host thread (backend workers fault too). */
 HMODULE module=NULL;char name[MAX_PATH]="?";uintptr_t at=(uintptr_t)info->ExceptionRecord->ExceptionAddress;
 if(GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,(LPCSTR)at,&module))
  GetModuleFileNameA(module,name,sizeof(name));
 fprintf(stderr,"FAULT code=0x%lx guest_pc=0x%llx address=0x%llx host=%s+0x%llx thread=%lu\n",
 info->ExceptionRecord->ExceptionCode,(unsigned long long)state.pc,
 (unsigned long long)(info->ExceptionRecord->NumberParameters>1 ? info->ExceptionRecord->ExceptionInformation[1] : 0),
 strrchr(name,'\\') ? strrchr(name,'\\')+1 : name,(unsigned long long)(at-(uintptr_t)module),GetCurrentThreadId());
 fflush(stderr); ExitProcess(32);
}
__attribute__((noreturn)) static void boundary(const char *kind, Cpu *c, uint64_t pc) {
 snapshot();
 if(application_terminate_result_set) printf("APPLICATION_TERMINATE_RESULT 0x%x\n",application_terminate_result);
 printf("COUNTERS calls=%u syscalls=%u\n",calls,syscalls);
 unsigned count=calls<64 ? calls : 64;
 for(unsigned i=0;i<count;i++) {
  unsigned slot=(calls-count+i)%64;
  printf("RECENT_CALL 0x%llx 0x%llx\n",(unsigned long long)recent_calls[slot].from,(unsigned long long)recent_calls[slot].target);
 }
 nvn_dump_recent();
 stop_dump(c);
 printf("STOP %s pc=0x%llx",kind,(unsigned long long)pc);
 for(unsigned i=0;i<8;i++) printf(" x%u=0x%llx",i,(unsigned long long)c->x[i]);
 printf("\n"); fflush(stdout); exit(20);
}
static void trace_call(uint64_t from,uint64_t target) {
 recent_calls[calls%64].from=from;recent_calls[calls%64].target=target;
 if(++calls>CALL_LIMIT) boundary("call-budget",&state,from);
 if(calls>10000) { if(calls==10001) puts("TRACE call lines capped at 10000; execution continues within step budget"); return; }
 printf("CALL 0x%llx 0x%llx\n",(unsigned long long)from,(unsigned long long)target);
}
/*MEMORY_TABLE*/
static struct { uint64_t address,size; HANDLE source; unsigned permission; } shared_views[64];
static struct { uint64_t source,destination,size; HANDLE backing; unsigned handle; } stack_maps[64];
static uint64_t thread_tls[32];
static struct { uint64_t address,size; void *data; unsigned refs,handle_open; } transfer_memory[32];
#include "nvmap_memory.h"
#include "memory_attributes.h"
static void snapshot(void) {
 if(!snapshot_path) return;
 app_snapshot_frame(snapshot_path);
 FILE *input=fopen("relocation-targets.bin","rb"), *output=fopen(snapshot_path,"wb");
 if(!input || !output) {fputs("Snapshot file failure\n",stderr); ExitProcess(33);}
 uint64_t address; unsigned count=0;
 while(fread(&address,8,1,input)==1) {
  if(++count>1000000) ExitProcess(33);
  uint64_t value=LD64(address);
  if(fwrite(&value,8,1,output)!=1) ExitProcess(33);
 }
 fclose(input); fclose(output);
 char cpu_path[1024];
 if(snprintf(cpu_path,sizeof(cpu_path),"%s.cpu",snapshot_path)>=(int)sizeof(cpu_path)) ExitProcess(33);
 output=fopen(cpu_path,"wb");
 if(!output || fwrite(&state,1,sizeof(state),output)!=sizeof(state)) ExitProcess(33);
 fclose(output);
 /* Bounded diagnostic stack for reconstructing abort arguments. Never dump
  * arbitrary guest pointers or the multi-gigabyte heap. */
 MEMORY_BASIC_INFORMATION stack_info;
 if(STACK_SIZE<=8*1024*1024 && state.sp>=STACK_BASE && state.sp<=STACK_BASE+STACK_SIZE &&
    VirtualQuery((void*)(uintptr_t)STACK_BASE,&stack_info,sizeof(stack_info)) && stack_info.State==MEM_COMMIT &&
    stack_info.Protect==PAGE_READWRITE && (uintptr_t)stack_info.BaseAddress<=STACK_BASE &&
    stack_info.RegionSize>=STACK_BASE-(uintptr_t)stack_info.BaseAddress+STACK_SIZE) {
  if(snprintf(cpu_path,sizeof(cpu_path),"%s.stack",snapshot_path)>=(int)sizeof(cpu_path)) ExitProcess(33);
  output=fopen(cpu_path,"wb");
  if(!output || fwrite((void*)(uintptr_t)STACK_BASE,1,STACK_SIZE,output)!=STACK_SIZE) ExitProcess(33);
  fclose(output);
 }
}
static Region query(uint64_t address) {
 uint64_t low=0,high=1ull<<39;
 if(address >= (1ull<<39)) return (Region){1ull<<39,0ull-(1ull<<39),16,0};
 for(unsigned i=0;i<32;i++) if(transfer_memory[i].size && address>=transfer_memory[i].address && address-transfer_memory[i].address<transfer_memory[i].size)
  return (Region){transfer_memory[i].address,transfer_memory[i].size,5,0};
 for(unsigned i=0;i<64;i++) if(stack_maps[i].size) {
  if(address>=stack_maps[i].source && address-stack_maps[i].source<stack_maps[i].size)
   return (Region){stack_maps[i].source,stack_maps[i].size,5,0};
  if(address>=stack_maps[i].destination && address-stack_maps[i].destination<stack_maps[i].size)
   return (Region){stack_maps[i].destination,stack_maps[i].size,11,3};
 }
 size_t count=sizeof(regions)/sizeof(regions[0]);
 for(size_t i=0;i<count+97;i++) {
  Region r;
  if(i<count) r=regions[i];
  else if(i==count) {
   uint64_t start=HEAP_BASE,end=HEAP_BASE+heap_size;
   for(unsigned j=0;j<64;j++) if(stack_maps[j].size) {
    uint64_t s=stack_maps[j].source,e=s+stack_maps[j].size;
    if(address<s && s<end) end=s;
    if(address>=e && e>start) start=e;
   }
   for(unsigned j=0;j<32;j++) if(transfer_memory[j].size) {
    uint64_t s=transfer_memory[j].address,e=s+transfer_memory[j].size;
    if(address<s && s<end) end=s;
    if(address>=e && e>start) start=e;
   }
   r=(Region){start,end-start,5,3};
   if(address>=start && address<end) r=attribute_clip(r,address);
  }
  else if(i<count+65) {unsigned view=i-count-1;r=(Region){shared_views[view].address,shared_views[view].size,6,shared_views[view].permission};}
  else {unsigned slot=i-count-65;r=(Region){thread_tls[slot],thread_tls[slot] ? 65536 : 0,12,3};}
  if(!r.size) continue;
  if(address>=r.base && address-r.base<r.size) return r;
  if(address<r.base && r.base<high) high=r.base;
  if(address>=r.base+r.size && r.base+r.size>low) low=r.base+r.size;
 }
 return (Region){low,high-low,0,0};
}
static void stop_dump(Cpu *c) {
 /* Diagnostic: AC_STOP_DUMP=x<reg>+<offset>:<bytes> dumps readable guest memory. */
 char dump[64];DWORD dump_n=GetEnvironmentVariableA("AC_STOP_DUMP",dump,sizeof(dump));
 unsigned dump_reg;unsigned long long dump_offset,dump_size;
 if(dump_n && dump_n<sizeof(dump) && sscanf(dump,"x%u+%lli:%lli",&dump_reg,&dump_offset,&dump_size)==3 && dump_reg<31 && dump_size<=4096) {
  uint64_t at=c->x[dump_reg]+dump_offset;Region r=query(at);
  if((r.permission&1) && at>=r.base && at-r.base<r.size && dump_size<=r.size-(at-r.base)) {
   printf("STOP_DUMP 0x%llx",(unsigned long long)at);
   for(unsigned long long i=0;i<dump_size;i++)printf("%s%02x",i%16?"":"\n ",((uint8_t*)(uintptr_t)at)[i]);
   printf("\n");
  } else printf("STOP_DUMP unavailable 0x%llx\n",(unsigned long long)at);
 }
}
static uint64_t static_memory_size(void) {
 uint64_t size=0;
 for(size_t i=0;i<sizeof(regions)/sizeof(regions[0]);i++) size+=regions[i].size;
 return size;
}
/* Lazy GPU write-back (Vulkan backend, exec.c): guest heap pages holding GPU results that the CPU has not read
 * yet are PAGE_NOACCESS. A CPU access faults; the vectored handler asks the backend to copy the results in and
 * lift the protection. Kernel I/O does not fault on such pages (it fails), so file reads/writes of guest buffers
 * prepare the range first. The hooks stay null with other backends. */
void (*nvn_lazy_flush_hook)(uint64_t addr,uint64_t size);
int (*nvn_lazy_fault_hook)(uint64_t addr);
static LONG CALLBACK nvn_lazy_vectored(PEXCEPTION_POINTERS info) {
 if(info->ExceptionRecord->ExceptionCode!=EXCEPTION_ACCESS_VIOLATION || info->ExceptionRecord->NumberParameters<2 || !nvn_lazy_fault_hook)
  return EXCEPTION_CONTINUE_SEARCH;
 return nvn_lazy_fault_hook((uint64_t)info->ExceptionRecord->ExceptionInformation[1]) ? EXCEPTION_CONTINUE_EXECUTION : EXCEPTION_CONTINUE_SEARCH;
}
int nvn_page_protect(uint64_t addr,uint64_t size,int noaccess) {
 static int installed;
 if(!installed) {installed=1;if(!AddVectoredExceptionHandler(1,nvn_lazy_vectored)) return 0;}
 DWORD old;
 return VirtualProtect((void*)(uintptr_t)addr,(SIZE_T)size,noaccess ? PAGE_NOACCESS : PAGE_READWRITE,&old)!=0;
}
/* 0: not committed, 1: accessible, 2: committed but no access (lazy write-back protection). */
int nvn_page_state(uint64_t addr) {
 MEMORY_BASIC_INFORMATION info;
 if(!VirtualQuery((void*)(uintptr_t)addr,&info,sizeof(info)) || info.State!=MEM_COMMIT) return 0;
 return info.Protect&PAGE_NOACCESS ? 2 : 1;
}
static void guest_io_prepare(uint64_t addr,uint64_t size) {if(nvn_lazy_flush_hook && size) nvn_lazy_flush_hook(addr,size);}
#include "exclusive_pair.h"
static int reserve_heap_range(void) {
 if(heap_reserved) return 1;
 /* Choose the range before guest execution/GetInfo. Windows ASLR can occupy
  * the preferred virtual range; only probe otherwise unused host addresses. */
 for(uint64_t candidate=heap_base;candidate+HEAP_LIMIT<=(1ull<<39);candidate+=HEAP_LIMIT) {
  /* Write-watched: the NVN backend re-uploads only pages the CPU wrote (plat_written_pages). */
  void *allocation=VirtualAlloc((void*)(uintptr_t)candidate,HEAP_LIMIT,MEM_RESERVE|MEM_WRITE_WATCH,PAGE_NOACCESS);
  if(allocation==(void*)(uintptr_t)candidate) {
   heap_base=candidate;heap_reserved=1;return 1;
  }
  DWORD error=GetLastError();
  if(allocation) VirtualFree(allocation,0,MEM_RELEASE);
  fprintf(stderr,"HOST heap reservation unavailable at 0x%llx (Windows error %lu)\n",(unsigned long long)candidate,(unsigned long)error);
 }
 return 0;
}
static uint32_t resize_heap(uint64_t size) {
 if(size%0x200000 || size>HEAP_LIMIT) boundary("invalid-heap-size",&state,state.pc);
 if(nvmap_above(HEAP_BASE+size)) boundary("heap-shrink-nvmap",&state,state.pc);
 for(unsigned i=0;i<64;i++) if(stack_maps[i].size && stack_maps[i].source+stack_maps[i].size>HEAP_BASE+size)
  boundary("heap-shrink-borrowed-stack",&state,state.pc);
 for(unsigned i=0;i<32;i++) if(transfer_memory[i].size && transfer_memory[i].address+transfer_memory[i].size>HEAP_BASE+size)
  boundary("heap-shrink-transfer-memory",&state,state.pc);
 uint64_t used=static_memory_size();
 if(used>MEMORY_BUDGET || size>MEMORY_BUDGET-used) return 0xd001;
 for(size_t i=0;i<sizeof(regions)/sizeof(regions[0]);i++)
  if(regions[i].base+regions[i].size>HEAP_BASE) boundary("heap-layout-overlap",&state,state.pc);
 if(size && !reserve_heap_range()) return 0xd001;
 if(size>heap_size && !VirtualAlloc((void*)(uintptr_t)(HEAP_BASE+heap_size),size-heap_size,MEM_COMMIT,PAGE_READWRITE)) {
  fprintf(stderr,"HOST heap commit failed (Windows error %lu)\n",(unsigned long)GetLastError());return 0xd001;
 }
 if(size<heap_size && !VirtualFree((void*)(uintptr_t)(HEAP_BASE+size),heap_size-size,MEM_DECOMMIT))
  boundary("host-heap-decommit",&state,state.pc);
 if(size<heap_size && update_uncached(HEAP_BASE+size,HEAP_BASE+heap_size,0)) boundary("heap-attribute-cleanup",&state,state.pc);
 heap_size=size;return 0;
}
static unsigned session_index(uint32_t handle) {
 if(handle<0x2000 || handle>=0x2040 || !session_handles[handle-0x2000]) boundary("invalid-session-handle",&state,state.pc);
 return session_handles[handle-0x2000]-1;
}
static uint32_t clone_session(unsigned session) {
 for(unsigned h=0;h<64;h++) if(!session_handles[h]) {
  session_handles[h]=session+1;session_peer_closed[h]=0;session_refs[session]++;return 0x2000+h;
 }
 boundary("session-handle-limit",&state,state.pc);
}
static uint32_t new_session(int kind) {
 for(unsigned i=0;i<64;i++) if(!session_refs[i]) {
  memset(&sessions[i],0,sizeof(sessions[i]));
  sessions[i].active=1; sessions[i].initialized=0; sessions[i].kind=kind; sessions[i].destination=1;
  sessions[i].domain=0; memset(sessions[i].objects,0,sizeof(sessions[i].objects));
  return clone_session(i);
 }
 boundary("session-limit",&state,state.pc);
}
static uint32_t copy_event(HANDLE *server_event) {
 if(!*server_event) {
  *server_event=CreateEventW(NULL,TRUE,FALSE,NULL);
  if(!*server_event) boundary("host-event-create",&state,state.pc);
 }
 for(unsigned i=0;i<64;i++) if(!events[i].handle) {
  if(!DuplicateHandle(GetCurrentProcess(),*server_event,GetCurrentProcess(),&events[i].handle,0,FALSE,DUPLICATE_SAME_ACCESS)) boundary("host-event-copy",&state,state.pc);
  events[i].access=1;return 0x3000+i;
 }
 boundary("event-handle-limit",&state,state.pc);
}
#include "applet_storage.h"
static void close_library_applet(void) {
 if(library_applet_running) boundary("close-running-library-applet",&state,state.pc);
 library_applet_created=0;
 library_completed=0;
 if(library_output) storage_release(library_output);
 library_output=0;
 for(unsigned i=0;i<library_input_count;i++) storage_release(library_inputs[i]);
 memset(library_inputs,0,sizeof(library_inputs));library_input_count=0;
 if(library_state_event && !CloseHandle(library_state_event)) boundary("library-event-close",&state,state.pc);
 library_state_event=NULL;
}
