static void rt_svc_body(Cpu*c,uint32_t imm,uint64_t pc);
/* Parallel mode: supervisor calls run under the kernel lock; any state change may wake other guest threads; a call
 * that leaves this thread waiting blocks its host thread (lock released while asleep); an exited thread ends. */
void rt_svc(Cpu*c,uint32_t imm,uint64_t pc) {
 if(!parallel_mode) {rt_svc_body(c,imm,pc);return;}
 if(imm==0xb) {
  /* SleepThread / yield: nothing else can end it early, so no kernel state is involved (the most frequent call:
   * worker threads poll in sleep loops). */
  int64_t ns=(int64_t)c->x[0];
  if(ns<-2) boundary("thread-yield-mode",c,pc);
  if(ns<=0) SwitchToThread();
  else {
   uint64_t until=rt_ticks()+(uint64_t)(((__uint128_t)(uint64_t)ns*19200000+999999999)/1000000000);
   for(uint64_t now=rt_ticks();now<until;now=rt_ticks()) {
    uint64_t left_ms=(until-now)/19200;
    if(left_ms>=2) Sleep((DWORD)(left_ms-1)); else SwitchToThread();
   }
  }
  c->x[0]=0;return;
 }
 klock();threads_initialize();
 rt_svc_body(c,imm,pc);
 if(guest_threads[current_thread].status!=THREAD_RUNNABLE) parallel_block();
 if(guest_threads[current_thread].status==THREAD_EXITED) {
  printf("PARALLEL guest thread %u exited\n",current_thread);fflush(stdout);
  klock_release_all();ExitThread(0);
 }
 kunlock();
}
/* svc #0xB1 (astral_chain/patches/cutscene-catchup-1.0.1.pchtxt): Dynamic-FPS's step code reports each frame whether
 * the game's cutscene mode is on (w21 == 0). The patch then uses the original fixed step, and nvn_present_pace
 * (nvn_hle.h) presents at 30 FPS. AC_CUTSCENE_FPS=60: w21 is set for the rest of the mod's step code (the measured
 * step, as in gameplay; the function restores x21 on return) and the presentation stays at 60. */
int cutscene_mode;
static void rt_svc_body(Cpu*c,uint32_t imm,uint64_t pc) {
