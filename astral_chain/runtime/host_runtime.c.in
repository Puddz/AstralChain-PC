 uint8_t account_user[16],object_account_user[32][16];
 HANDLE save_file,object_save_file[32];
 unsigned audio_output,object_audio_output[32];
 AudioDeviceState audio_device,object_audio_device[32]; } sessions[64];
/* Handle slots and shared server objects have independent lifetimes. */
static unsigned session_handles[64],session_refs[64],session_peer_closed[64];
static size_t log_bytes;
/* Requested console profiles are application state, not Windows clock rates.
